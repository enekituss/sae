{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bizkaibus-sae-dispatcher",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
